# Copy this file to ".env" and edit the values.
# FOODEASE_DB=mysql  -> use MySQL (default, the project's real database)
# FOODEASE_DB=sqlite -> zero-setup fallback for quick demos/testing
FOODEASE_DB=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=foodease

# Used to sign login cookies. Set to a long random string.
SECRET_KEY=change-this-to-a-long-random-string
